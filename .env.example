# banco
DB_NAME=vita
DB_USER=vita
DB_PASSWORD=1234
DB_HOST=localhost
# DB_HOST=postgres - caso dockerizar API
DB_PORT=5432
# DB_DIALECT=postgres - remover
DB_SSL=false
DB_SSL_CA=
# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
# node
PORT=8080
NODE_ENV=development
# jwt
JWT_SECRET=sua_chave_secreta_json_web_token_para_desenvolver_a_api
JWT_EXPIRES_IN=1h
# cors
URL_WEB=http://localhost:3000
URL_EXPO=http://localhost:8081
# storage local
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
STORAGE_TMP_TTL_HOURS=24
