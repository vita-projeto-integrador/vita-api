# configurações de banco
DB_NAME=ponskan
DB_USER=root
DB_PASSWORD=troque_essa_senha
DB_HOST=localhost
DB_PORT=3307
# configurações da API
PORT=8080
NODE_ENV=development
# redis
REDIS_HOST=localhost
REDIS_PORT=6380
# segurança (JWT)
# gerar via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta
JWT_EXPIRES_IN=1h
# cors
URL_WEB=http://localhost:3000
# portas publicadas no host pelo docker-compose
# (DB_PORT e REDIS_PORT acima devem ser iguais a estas)
API_HOST_PORT=8080
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
