# banco (o Compose usa estes valores para criar o banco e o usuário)
DB_NAME=vita
DB_USER=vita
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432          # porta publicada no host
DB_SSL=false
DB_SSL_CA=
# redis
REDIS_HOST=localhost
REDIS_PORT=6379       # porta publicada no host
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
# node
PORT=8080
NODE_ENV=development
# jwt
JWT_SECRET=sua_chave_secreta_json_web_token_para_desenvolver_a_api
JWT_EXPIRES_IN=1h
# cors
URL_WEB=http://localhost:3000
URL_EXPO=http://localhost:8081
# storage local
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
STORAGE_TMP_TTL_HOURS=24
# URLs assinadas
STORAGE_PUBLIC_URL=http://localhost:8080/api/files
STORAGE_URL_SECRET=chave_secreta_para_assinar_urls_de_arquivos
STORAGE_URL_TTL_MINUTES=60
# docker (opcionais)
API_HOST_PORT=8080
PGADMIN_EMAIL=admin@vita.com
PGADMIN_PASSWORD=admin
