		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"file-type": "^22.0.2",
		"geojson": "^0.5.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.3.0",
		"mysql2": "^3.24.2",
		"pg": "^8.23.0",
		"sequelize": "^6.37.8",
		"sharp": "^0.35.4",
		"url": "^0.11.4",
		"uuid": "^14.0.2",
		"validator": "^13.15.35",
		"zod": "^4.6.5"
	},
	"type": "module"
