{
  "name": "ponskan-api",
  "version": "1.0.0",
  "description": "API do projeto integrador em Node.js + Express.js",
  "main": "app.js",
  "scripts": {
    "dev": "npx nodemon -r dotenv/config server.js",
    "start": "npx node -r dotenv/config server.js",
    "docker:up": "docker compose up -d",
    "docker:up:build": "docker compose up -d --build",
    "docker:infra": "docker compose up -d mysql redis",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:restart": "docker compose restart api",
    "docker:rebuild": "docker compose up -d --build --renew-anon-volumes api",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f api",
    "docker:logs:all": "docker compose logs -f",
    "docker:sh": "docker compose exec api sh",
    "docker:mysql": "docker compose exec mysql mysql -uroot -p",
    "docker:redis": "docker compose exec redis redis-cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermexmada/ponskan-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/guilhermexmada/ponskan-api/issues"
  },
  "homepage": "https://github.com/guilhermexmada/ponskan-api#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "bullmq": "^5.76.5",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "file-type": "^22.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "nodemon": "^3.1.14",
    "sequelize": "^6.37.8",
    "sharp": "^0.34.5",
    "url": "^0.11.4",
    "uuid": "^13.0.0",
    "validator": "^13.15.35"
  }
}